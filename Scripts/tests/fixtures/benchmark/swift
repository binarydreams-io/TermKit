#!/usr/bin/env bash

set -euo pipefail

if [[ "${1:-}" == "--version" ]]; then
    printf '%s\n' "Swift version 6.3.3 (swift-6.3.3-RELEASE)"
    exit 0
fi

printf 'command: %s\n' "$1" >> "$BENCHMARK_SWIFT_LOG"
arguments=("$@")
for argument in "${arguments[@]:1}"; do
    printf 'argument: %s\n' "$argument" >> "$BENCHMARK_SWIFT_LOG"
done

if [[ "${1:-}" == "test" && "${2:-}" == "list" ]]; then
    test_count="${BENCHMARK_PERFORMANCE_TEST_COUNT:-13}"
    tests=(
        'TUIPerformanceTests.RenderPipelinePerformanceTests/localizedAnimation()'
        'TUIPerformanceTests.RenderPipelinePerformanceTests/fullRepaint()'
        'TUIPerformanceTests.RenderPipelinePerformanceTests/unchangedFrame()'
        'TUIPerformanceTests.IdleSystemTests/noPeriodicIdleWake()'
        'TUIPerformanceTests.RenderPipelinePerformanceTests/oneLogicalWrite()'
        'TUIPerformanceTests.ScalabilityPerformanceTests/lazyConversation()'
        'TUIPerformanceTests.ScalabilityPerformanceTests/localToolRowMutation()'
        'TUIPerformanceTests.ScalabilityPerformanceTests/boundedInternerRebuild()'
        'TUIPerformanceTests.SchedulerPerformanceTests/coalescing()'
        'TUIPerformanceTests.SchedulerPerformanceTests/noStaleQueue()'
        'TUIPerformanceTests.SchedulerPerformanceTests/idleHasNoDeadline()'
        'TUIPerformanceTests.RenderPipelinePerformanceTests/declarativePaintAnimation()'
        'TUIPerformanceTests.ScalabilityPerformanceTests/oneRowDamage()'
    )
    printf '%s\n' "${tests[@]:0:test_count}"
fi
